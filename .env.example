# Banco Postgres (Neon via Vercel Marketplace)
DATABASE_URL=

# Vercel Blob (fotos). Criada em Storage > Blob no painel da Vercel
BLOB_READ_WRITE_TOKEN=

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Acesso da Adriana ao painel. SESSION_SECRET: openssl rand -base64 32
ADMIN_PASSWORD=
SESSION_SECRET=

# Proteção da rotina diária. CRON_SECRET: openssl rand -base64 32
CRON_SECRET=

# URL pública do site (usada na mensagem do WhatsApp)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
